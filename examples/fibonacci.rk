fun fibonacci(n: Int): Int {

    if (n <= 1) {
        return n
    }

    var a: Int = 0
    var b: Int = 1
    var i: Int = 2

    while (i <= n) {
        val next: Int = a + b

        a = b
        b = next
        i = i + 1
    }

    return b
}

fun main(): Int {
    println("피보나치 수열의 몇번째 항을 구하시겠습니까?")
    val x: Int = input()
    val y: Int = fibonacci(x)
    println(y)
    return 0
}