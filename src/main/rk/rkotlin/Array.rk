import rkotlin.ArrayIterator

public class Array<T> : Iterable<T>, Iterator<T> {
    private var data: BufferPointer<T>;
    private var count: Int32;
    private var iterationIndex: Int32;

    public Array(size: Int32) {
        require(size > 0, "array size must be positive");

        count = size;
        iterationIndex = 0;
        data = alloc<T>(size);
    }

    public fun size(): Int32 {
        return count;
    }

    public fun length(): Int32 {
        return size();
    }

    public fun isEmpty(): Bool {
        return count == 0;
    }

    public fun get(index: Int32): T {
        require(index >= 0, "negative array index");
        require(index < count, "array index out of bounds");

        return (data + index).read();
    }

    public fun set(index: Int32, value: T): Void {
        require(index >= 0, "negative array index");
        require(index < count, "array index out of bounds");

        (data + index).write(value);
    }

    public fun iterator(): Iterator<T> {
        return new ArrayIterator<T>(this)
    }

    public fun hasNext(): Bool {
        return iterationIndex < count;
    }

    public fun next(): T {
        require(hasNext(), "iterator has no next element");
        val value = get(iterationIndex);
        iterationIndex = iterationIndex + 1;
        return value;
    }

    public native fun toString(): String = "array.toString";

    public override fun isFreed(): Bool {
        return data.isFreed();
    }

    public override fun free(): Void {
        require(!data.isFreed(), "array already freed");
        data.free();
    }

    public override fun address(): BufferPointer<T> {
        require(!data.isFreed(), "array is freed");
        return data;
    }
}